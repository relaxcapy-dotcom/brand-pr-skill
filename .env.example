# Public Supabase project settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-6-luna
CONNECTOR_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_RANDOM_KEY
APP_URL=http://localhost:3000

# Optional Notion OAuth application (read-only search connector)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
